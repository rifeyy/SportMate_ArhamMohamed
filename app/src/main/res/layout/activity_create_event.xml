<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Sport Event"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#0B6623"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/edtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Event title"
            android:inputType="text" />

        <EditText
            android:id="@+id/edtSport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Sport: Football, Basketball, Running..."
            android:inputType="text"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Location"
            android:inputType="text"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Date: 15/05/2026"
            android:inputType="date"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Time: 18:00"
            android:inputType="time"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Level: Beginner / Intermediate / Advanced"
            android:inputType="text"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtMaxPlayers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Max players"
            android:inputType="number"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnSaveEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Event"
            android:layout_marginTop="28dp" />

    </LinearLayout>

</ScrollView>